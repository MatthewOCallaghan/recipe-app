---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';

interface Props {
  title?: string;
  description?: string;
  active?: 'recipes' | 'plan';
}

const { title, description = SITE_DESCRIPTION, active = 'recipes' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Caveat and Lora only: the other families belonged to the themes we dropped. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader active={active} />
    <main class="page">
      <slot />
    </main>
  </body>
</html>
